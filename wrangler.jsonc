{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "kortex",
	"compatibility_date": "2026-05-24",
	// Custom domains. Declared here (not added via UI) so they're version-
	// controlled and reproducible. wrangler is idempotent — re-deploys
	// reconcile state without disrupting existing mappings.
	"routes": [
		{
			"pattern": "kortexconsulting.com",
			"custom_domain": true
		},
		{
			"pattern": "staging.kortexconsulting.com",
			"custom_domain": true
		}
	],
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "kortex"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}